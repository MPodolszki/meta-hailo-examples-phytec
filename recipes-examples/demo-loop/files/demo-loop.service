[Unit]
Description=Kiosk demo loop (Facematch / Object Detection / Whisper)
Requires=weston.service
After=weston.service

[Service]
Type=simple
User=weston
Group=weston
Environment="XDG_RUNTIME_DIR=/run/user/1000" "WAYLAND_DISPLAY=wayland-1"
RuntimeDirectory=demo-loop
ExecStart=/usr/bin/demo-orchestrator
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
