#!/usr/bin/env python3
"""Detect whether HDMI or LVDS is connected and configure Weston accordingly.

Runs once, before weston.service starts (see weston-output-config.service).
Rewrites the [output] stanzas in /etc/xdg/weston/weston.ini to enable the
connected head and explicitly disable the other one, and drops the chosen
logical screen kind ("hdmi"/"lvds") into /run/demo-display-kind so the demo
orchestrator and demo-celebrity-face-match's own -s flag can agree with it.
"""

import glob
import logging
import os
import re
import sys

logging.basicConfig(level=logging.INFO, format="%(message)s")
log = logging.getLogger("detect-display")

WESTON_INI = "/etc/xdg/weston/weston.ini"
KIND_FILE = "/run/demo-display-kind"

# Logical demo screen kind -> DRM connector name to look for.
CONNECTORS = {
    "hdmi": "HDMI-A-1",
    "lvds": "LVDS-1",
}

MARKER_BEGIN = "# BEGIN demo-display-kind (autogenerated, do not edit by hand)"
MARKER_END = "# END demo-display-kind"


def connector_status(name):
    """Return 'connected', 'disconnected', or None if no such connector."""
    matches = glob.glob(f"/sys/class/drm/*-{name}/status")
    if not matches:
        return None
    with open(matches[0]) as fh:
        return fh.read().strip()


def choose_kind():
    """HDMI wins if connected, otherwise LVDS, otherwise LVDS as a last resort."""
    statuses = {kind: connector_status(name) for kind, name in CONNECTORS.items()}
    log.info("connector status: %s", statuses)

    if statuses.get("hdmi") == "connected":
        return "hdmi"
    if statuses.get("lvds") == "connected":
        return "lvds"

    log.warning("neither HDMI nor LVDS reports 'connected' -- defaulting to lvds")
    return "lvds"


def _strip_static_output_sections(text, connector_names):
    """Comment out any pre-existing, hand-written [output] section for one
    of *connector_names* that sits outside our managed marker block, so it
    can't fight with the block we're about to (re)write."""
    marker_pattern = re.compile(
        re.escape(MARKER_BEGIN) + r".*?" + re.escape(MARKER_END) + r"\n?",
        re.DOTALL,
    )
    managed_span = marker_pattern.search(text)
    protected = (managed_span.start(), managed_span.end()) if managed_span else None

    section_pattern = re.compile(
        r"^\[output\]\n(?:[^\[\n][^\n]*\n?)*", re.MULTILINE)

    def maybe_comment(match):
        if protected and protected[0] <= match.start() < protected[1]:
            return match.group(0)
        if not re.search(
                r"^name\s*=\s*(" + "|".join(re.escape(n) for n in connector_names) + r")\s*$",
                match.group(0), re.MULTILINE):
            return match.group(0)
        commented = "\n".join(
            line if line.startswith("#") else f"#{line}"
            for line in match.group(0).splitlines()
        )
        return commented + "\n"

    return section_pattern.sub(maybe_comment, text)


def rewrite_weston_ini(kind):
    connector = CONNECTORS[kind]
    other_kind, other_connector = next(
        (k, v) for k, v in CONNECTORS.items() if k != kind
    )

    block = (
        f"{MARKER_BEGIN}\n"
        f"[output]\n"
        f"name={connector}\n"
        f"mode=preferred\n"
        f"\n"
        f"[output]\n"
        f"name={other_connector}\n"
        f"mode=off\n"
        f"{MARKER_END}\n"
    )

    if os.path.exists(WESTON_INI):
        with open(WESTON_INI) as fh:
            text = fh.read()
    else:
        text = ""

    text = _strip_static_output_sections(text, CONNECTORS.values())

    pattern = re.compile(
        re.escape(MARKER_BEGIN) + r".*?" + re.escape(MARKER_END) + r"\n?",
        re.DOTALL,
    )
    if pattern.search(text):
        text = pattern.sub(block, text)
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += "\n" + block

    tmp_path = WESTON_INI + ".tmp"
    with open(tmp_path, "w") as fh:
        fh.write(text)
    os.replace(tmp_path, WESTON_INI)
    log.info("wrote %s -> %s (other head %s off)", WESTON_INI, connector, other_connector)


def main():
    kind = choose_kind()
    rewrite_weston_ini(kind)

    os.makedirs(os.path.dirname(KIND_FILE), exist_ok=True)
    with open(KIND_FILE, "w") as fh:
        fh.write(kind + "\n")
    log.info("wrote %s -> %s", KIND_FILE, kind)
    return 0


if __name__ == "__main__":
    sys.exit(main())
